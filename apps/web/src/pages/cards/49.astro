---
import CardLayout from '../../layouts/CardLayout.astro';
import CodeBlock from '../../components/shared/CodeBlock.astro';
import ReadmeContent from '../../content/cards/49-tables-and-grids.mdx';

const cardNumber = '49';
const cardTitle = 'Tables & Grids';
---

<CardLayout title={cardTitle} cardNumber={cardNumber}>
  <section class="readme">
    <ReadmeContent />
  </section>

  <section class="demo">
    <h2>Isolated examples</h2>
    <p class="demo-label">
      This card builds each page with <code>page.setContent</code> inside the
      spec, so there is no live page to click. Run the tests to see each
      pattern.
    </p>
  </section>

  <section class="test-info">
    <h2>Run This Example</h2>
    <CodeBlock language="bash" code="pnpm test src/49-tables-and-grids" />
  </section>
</CardLayout>
