{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noEmit": true,
    "types": [],
    // TS 7 checks side-effect imports by default; this config has no Vite
    // types, so the component's CSS import would fail to resolve.
    "noUncheckedSideEffectImports": false,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/i18n/**/*.ts",
    "src/components/cards/Card41I18n.tsx"
  ]
}
